# Reference only: export settings in the shell; the app does not auto-load .env.
DAYFLOW_DB=backend/dayflow.sqlite3
DAYFLOW_LLM_MODE=off  # off | ollama (local open-weight) | openai
DAYFLOW_LLM_MODEL=gpt-4.1-mini
DAYFLOW_LLM_BASE_URL=https://api.openai.com/v1
DAYFLOW_LLM_API_KEY=
# Set before initial seeding; public default is for a local synthetic demo only.
DAYFLOW_DEMO_PASSWORD=Dayflow-demo-2026!
DAYFLOW_SECURE_COOKIES=0
DAYFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
DAYFLOW_SCORECARD=artifacts/scorecard.json
DAYFLOW_API_URL=http://127.0.0.1:8000
# Open-weight via Ollama (verify the model's licence and acceptable-use terms first):
#   ollama pull gpt-oss:20b   (Apache-2.0 + gpt-oss usage policy)   or   ollama pull qwen3:8b (Apache-2.0)
#   export DAYFLOW_LLM_MODE=ollama DAYFLOW_LLM_MODEL=gpt-oss:20b
