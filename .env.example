# Reference only: export these in the shell; the app does not auto-load a .env file.
# Never commit real values. Everything here is optional for a local demo.

# --- Backend ---
DAYFLOW_DB=backend/dayflow.sqlite3          # use a new path for a clean demo database
DAYFLOW_DEMO_PASSWORD=Dayflow-demo-2026!    # set BEFORE first start; local synthetic demo only
DAYFLOW_SECURE_COOKIES=0                    # set 1 behind HTTPS
DAYFLOW_ALLOWED_ORIGINS=                    # extra browser origins for POST requests (comma separated)
DAYFLOW_SCORECARD=artifacts/scorecard.json

# --- Optional AI (off by default; everything works on the rules plan without it) ---
DAYFLOW_LLM_MODE=off                        # off | ollama (local open-weight) | openai (any OpenAI-compatible)
DAYFLOW_LLM_MODEL=qwen3:1.7b                # verify the model's licence and acceptable-use terms first
DAYFLOW_LLM_BASE_URL=                       # only for openai mode
DAYFLOW_LLM_API_KEY=                        # only for openai mode; never commit
DAYFLOW_LLM_TIMEOUT=                        # seconds, optional
DAYFLOW_LLM_CACHE=evidence/llm-cache.json   # replay recorded answers without model calls
#   ollama pull qwen3:1.7b    (Apache-2.0, light; used for the recorded evaluation)

# --- Optional email for notifications (in-app notifications always work) ---
DAYFLOW_SMTP_HOST=
DAYFLOW_SMTP_PORT=587
DAYFLOW_SMTP_USER=
DAYFLOW_SMTP_PASSWORD=
DAYFLOW_SMTP_FROM=dayflow@localhost
DAYFLOW_NOTIFY_OVERRIDE=                    # send ALL mail to this one address (safe for demos)

# --- Web app (web/) ---
DAYFLOW_API=http://127.0.0.1:8000           # where `npm run dev` proxies /api
VITE_SHOW_DEMO_HINT=1                       # set 0 to hide the demo-account line on the sign-in page
